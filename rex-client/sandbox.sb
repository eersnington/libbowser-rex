;; Guard for the Rex dev client and dev server: they must never change the
;; user's real Rex state, talk to the real server, or touch the keychain.
(version 1)
(allow default)
(deny file-write* (subpath (string-append (param "HOME") "/Library/Application Support/rex")))
(deny file-write* (subpath (string-append (param "HOME") "/Library/Application Support/com.superlogical.rex")))
(deny file-write* (subpath (string-append (param "HOME") "/.config/rex")))
(deny network-outbound (literal (string-append (param "HOME") "/Library/Application Support/rex/server.sock")))
(deny mach-lookup (global-name "com.apple.SecurityServer"))
(deny mach-lookup (global-name "com.apple.securityd.xpc"))
